# Activer le moteur de réécriture
RewriteEngine On

# Ne pas réécrire les fichiers et dossiers qui existent
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Tout le reste → index.php
RewriteRule ^(.*)$ index.php [QSA,L]

# ── Headers de sécurité ──────────────────────────────────────────────
<IfModule mod_headers.c>
    # Anti-clickjacking : interdit l'intégration dans un iframe
    Header always set X-Frame-Options "DENY"

    # Anti-MIME sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Referrer : n'envoie que l'origine (pas l'URL complète)
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # CSP : sources autorisées pour chaque type de ressource
    # 'self' = uniquement ce domaine
    # fonts.googleapis.com et cdnjs = nos CDN externes autorisés
    Header always set Content-Security-Policy "\
        default-src 'self'; \
        script-src 'self' https://cdnjs.cloudflare.com; \
        style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; \
        font-src 'self' https://fonts.gstatic.com; \
        img-src 'self' data:; \
        connect-src 'self'"

    # Supprime la signature du serveur (ne pas révéler Apache/version)
    Header always unset X-Powered-By
    Header always unset Server
</IfModule>

# Désactive l'affichage du contenu des dossiers
Options -Indexes